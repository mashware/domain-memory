{
  "name": "@mashware/domain-memory-server",
  "version": "0.2.1",
  "description": "Domain Memory MCP server (stdio). Local-first MCP server that serves the business-domain knowledge of a project to any MCP-compatible agent.",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "domain-knowledge",
    "knowledge-base",
    "ai-agent",
    "llm",
    "claude",
    "cursor",
    "copilot"
  ],
  "author": "Alberto Vioque",
  "homepage": "https://github.com/mashware/domain-memory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mashware/domain-memory.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/mashware/domain-memory/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    }
  },
  "bin": {
    "domain-memory-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "prepack": "cp ../../README.md ./README.md && cp ../../LICENSE ./LICENSE",
    "postpack": "rm -f README.md LICENSE"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xenova/transformers": "^2.17.0",
    "better-sqlite3": "^11.3.0",
    "sqlite-vec": "^0.1.6",
    "gray-matter": "^4.0.3",
    "ulid": "^2.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
