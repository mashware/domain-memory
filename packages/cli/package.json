{
  "name": "@mashware/domain-memory",
  "version": "0.2.3",
  "description": "Domain Memory — local MCP server that captures the why behind your code. CLI to install, reindex, check drift, and browse the local web viewer.",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "domain-knowledge",
    "knowledge-base",
    "documentation",
    "ai-agent",
    "llm",
    "claude",
    "claude-code",
    "cursor",
    "copilot"
  ],
  "author": "Alberto Vioque",
  "homepage": "https://github.com/mashware/domain-memory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mashware/domain-memory.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/mashware/domain-memory/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/index.js",
  "bin": {
    "domain-memory": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "prepack": "rm -rf templates && cp -r ../../templates ./templates && cp ../../README.md ./README.md && cp ../../LICENSE ./LICENSE",
    "postpack": "rm -rf templates && rm -f README.md LICENSE"
  },
  "dependencies": {
    "@mashware/domain-memory-server": "0.2.3",
    "@mashware/domain-memory-web": "0.2.3",
    "@hono/node-server": "^1.13.0",
    "commander": "^12.1.0",
    "prompts": "^2.4.2",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
